{
    "name": "roundly-consulting/events-for-laravel",
    "description": "Real-world events for any Eloquent app: reusable venues with near-me search, ticket tiers priced in Money, RSVPs with a race-free waitlist, QR check-in, co-hosts and invite-only events, iCalendar feeds and schema.org JSON-LD.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "events",
        "event-management",
        "rsvp",
        "waitlist",
        "check-in",
        "ics",
        "icalendar",
        "json-ld",
        "venues",
        "geolocation"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/events-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/events-for-laravel"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../tags-for-laravel*",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/tags-for-laravel",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "roundly-consulting/crypto-for-laravel": "^1.2.0",
        "roundly-consulting/enums-for-laravel": "^1.1.0",
        "roundly-consulting/geolocation-for-laravel": "^2.0.4",
        "roundly-consulting/lifecycle-for-laravel": "^1.1.0",
        "roundly-consulting/media-library-for-laravel": "^1.3.1",
        "roundly-consulting/money-for-laravel": "^1.0.3",
        "roundly-consulting/package-toolkit-for-laravel": "^1.3.0",
        "roundly-consulting/qr-for-laravel": "^1.1.2",
        "roundly-consulting/query-builder-for-laravel": "^1.2.1",
        "roundly-consulting/sluggable-for-laravel": "^1.1.3",
        "roundly-consulting/tags-for-laravel": "@dev",
        "roundly-consulting/translatable-for-laravel": "^1.1.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^1.6.1"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Events\\": "src",
            "RoundlyConsulting\\Events\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Events\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Events\\EventsServiceProvider"
            ]
        }
    },
    "suggest": {
        "roundly-consulting/teams-for-laravel": "Team organizers (the Organizer recipe)",
        "roundly-consulting/attributes-for-laravel": "Custom event fields (recipe)",
        "roundly-consulting/comments-for-laravel": "Event discussion (recipe)",
        "roundly-consulting/reviews-for-laravel": "Post-event reviews (recipe)"
    }
}
