parameters:
    level: 7
    paths:
        - src
        - database
        - config
        # Host-model traits are analysed only where a class uses them.
        - tests/Fixtures/Models/User.php
        - tests/Fixtures/Models/Team.php
        - tests/Fixtures/Models/Guest.php
    excludePaths:
        # Pest's expect()->extend() closures bind $this to the expectation at runtime; the matchers
        # are exercised by the suite (the likes / tags precedent).
        - src/Testing/EventExpectations.php
    # This package ships its own config/ dir; env() is correct there.
    configDirectories:
        - config
